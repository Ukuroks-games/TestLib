{
	"editor.insertSpaces": false,
	"editor.defaultFormatter": "JohnnyMorganz.stylua",
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"diffEditor.ignoreTrimWhitespace": false
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[luau]": {
		"editor.defaultFormatter": "JohnnyMorganz.stylua"
	},
	"cSpell.enabled": true,
	"cSpell.words": [
		"egor",
		"Roblox",
		"rojo",
		"setmetatable",
		"stdlib",
		"Testlib"
	],

	"cSpell.ignorePaths": [
		"vscode-extension",
		".git/objects",
		".vscode",	// ignore vscode workspace settings
		".vscode-insiders",
		"*.toml"	// ignore toml files
	],

	"luau-lsp.sourcemap.rojoProjectFile": "test.project.json",
	"luau-lsp.sourcemap.useVSCodeWatcher": true,
	"luau-lsp.sourcemap.generatorCommand": "make sourcemap",
}
